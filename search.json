---
layout: null
permalink: /search.json
---
{% assign searchable_pages = site.html_pages | where_exp: "p", "p.title and p.search_exclude != true" %}
{% assign search_items = site.posts | concat: searchable_pages %}
[
{% for item in search_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "description": {{ item.description | default: item.excerpt | strip_html | strip_newlines | jsonify }},
    "topic": {{ item.topic | default: "" | jsonify }},
    "tags": {{ item.tags | jsonify }},
    "content": {{ item.content | strip_html | strip_newlines | jsonify }},
    "date": {% if item.date %}{{ item.date | date_to_xmlschema | jsonify }}{% else %}""{% endif %}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
